# Backend API (apps/server) - base URL including the /api/v1 prefix
NEXT_PUBLIC_API_URL=http://localhost:8091/api/v1

# NextAuth (used by the /admin dashboard only)
# Generate with: npx auth secret
AUTH_SECRET=your-secret-key-here

# Cloudflare R2 (used by the admin file-upload flow - upload/signed-url proxying
# and building public image URLs after upload)
NEXT_PUBLIC_CLOUDFLARE_R2_WORKER_URL=https://your-r2-worker.workers.dev
NEXT_PUBLIC_CLOUDFLARE_R2_URL=https://pub-xxxxx.r2.dev

# Optional: Google Analytics for the public site
NEXT_PUBLIC_GA_ID=
